# Caddy reverse proxy with automatic, publicly-trusted TLS (Let's Encrypt).
# Certificates are obtained and renewed automatically and stored in the
# persistent `caddy-data` volume, so they survive deploys and restarts.
# DOMAIN is provided by the environment (e.g. itikad.site).
{
	admin off
}

# ---- Optional drop-in sites (e.g. the gated Tulip dashboard) ----
# Files placed in the conf.d volume are imported here. The glob matches nothing
# by default, so this is a no-op until a drop-in is added on the host; the main
# site below is never affected. See deploy/tulip/README.md.
import /etc/caddy/conf.d/*.caddy

# ---- Canonical HTTPS site ----
# Caddy auto-obtains/renews the cert for this host and auto-redirects its own
# HTTP (port 80) traffic to HTTPS.
{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		-Server
	}

	# API + SSE -> backend (Host header preserved; streaming kept alive).
	@api path /api/*
	handle @api {
		reverse_proxy backend:8000 {
			flush_interval -1
			transport http {
				read_timeout 0
			}
		}
	}

	# SPA with history-API fallback.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

# ---- www -> apex (canonical) ----
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

# ---- Everything else over plain HTTP (e.g. the raw public IP, unknown Host) ----
# The backend is NEVER served here, so HTTP/IP cannot bypass TLS. Localhost keeps
# /api/health for the deploy health-gate; all else is redirected to canonical HTTPS.
:80 {
	@health {
		path /api/health
		host 127.0.0.1 localhost
	}
	handle @health {
		reverse_proxy backend:8000 {
			flush_interval -1
		}
	}
	handle {
		redir https://{$DOMAIN}{uri} permanent
	}
}
