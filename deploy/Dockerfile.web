# Build the SPA, then serve it with Caddy which also reverse-proxies the API.
FROM node:22-slim AS build
WORKDIR /web
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm ci || npm install
COPY frontend/ ./
RUN npm run build

FROM caddy:2.8-alpine
COPY deploy/Caddyfile /etc/caddy/Caddyfile
# Drop-in site configs (mounted as a volume at runtime) are imported by the
# Caddyfile; create the dir so the import glob is always valid.
RUN mkdir -p /etc/caddy/conf.d
COPY --from=build /web/dist /srv
EXPOSE 80 443
