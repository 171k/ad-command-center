# Tulip .env for iHack 2026 — copy to Tulip's repo root as `.env` and fill in.
# Keys mirror Tulip's upstream .env.example; values here are placeholders.

# TimescaleDB DSN (leave as-is; matches Tulip's compose).
TIMESCALE="postgres://tulip@timescale:5432/tulip"

# --- Per-competition settings (CONFIRM WITH ORGANISERS ON GAME DAY) ---
# First tick start, ISO-8601 UTC. Set to when the game network goes live.
TICK_START="2026-11-17T09:00:00Z"
# Tick length in MILLISECONDS (e.g. 120000 = 2 min). Confirm with organisers.
TICK_LENGTH=120000
# Flag format as a regex. REPLACE with the real iHack flag regex.
FLAG_REGEX="[A-Z0-9]{31}="

# Your team's vulnbox IP and team id (from the organisers' network sheet).
VM_IP="10.0.0.1"
TEAM_ID="1"

# --- Where the traffic comes from ---
# Host directory holding rotating pcaps (and Suricata eve.json if used). The
# assembler watches it with inotify. Point your tcpdump output here, or rsync
# captures from the vulnbox into it.
TRAFFIC_DIR_HOST="./pcaps"

# Optional: capture filter, applied by the sniffer / PCAP-over-IP.
#BPF="port 8080 or port 5555"

# Optional: stream packets live from the vulnbox instead of copying files.
# Run a pcap-broker on the vulnbox and point Tulip at it (comma-separate many).
#PCAP_OVER_IP="100.x.y.z:1337"

# Optional flag-id scraping (only if the organisers expose a flag-id endpoint).
#FLAGID_SCRAPE=1
#FLAGID_ENDPOINT="http://10.0.0.254/flagids"
