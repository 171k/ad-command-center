# Copy to .env and adjust. NEVER commit the real .env.
# The shared password is NOT set here. Set it with the admin CLI:
#   python -m app.admin set-password

ADCC_ENVIRONMENT=development           # development | production
ADCC_SECRET_KEY=change-me-to-a-long-random-string   # signs CSRF/session tokens
ADCC_COOKIE_SECURE=false               # true when served over HTTPS

# Session
ADCC_SESSION_TTL_SECONDS=43200

# SOC / ingestion limits (tuned for ~4GB VPS)
ADCC_MAX_EVENTS=500000
ADCC_EVENT_RETENTION_DAYS=14
ADCC_CORRELATION_WINDOW_SECONDS=600
ADCC_INGEST_QUEUE_MAX=10000
ADCC_WORKER_CONCURRENCY=2

# Uploads
ADCC_MAX_UPLOAD_BYTES=52428800

# Feature gates: OFF by default; require explicit, authorized opt-in
ADCC_ENABLE_EXPLOIT_RUNNER=false
ADCC_ENABLE_TASK_EXECUTION=false
ADCC_ENABLE_SCHEDULED_JOBS=false
ADCC_ENABLE_DEMO_DATA=false
